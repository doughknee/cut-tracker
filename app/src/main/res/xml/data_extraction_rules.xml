<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup and device transfer (API 31+): only the Room db and DataStore. Listing includes excludes everything else, so photos/ stays out. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="cut.db" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="cut.db" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
