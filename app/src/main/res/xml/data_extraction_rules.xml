<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup and device transfer (API 31+): the Room db and DataStore, never the photos folder. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="cut.db" />
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="photos/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="cut.db" />
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="photos/" />
    </device-transfer>
</data-extraction-rules>
