<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="110dp"
    android:layout_height="40dp"
    android:background="@color/ground"
    android:orientation="horizontal"
    android:padding="10dp"
    android:gravity="center_vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="11" android:textColor="@color/widget_text" android:textSize="18sp" android:textStyle="bold" />
    <!-- RemoteViews cannot inflate a plain View; a TextView carries the bar. -->
    <TextView android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:layout_marginStart="10dp" android:background="@color/accent" />
</LinearLayout>
