# kotlinx.serialization serializers are generated by the compiler plugin; nothing extra needed yet.

# WorkManager instantiates InputMerger subclasses reflectively; R8 drops their no-arg constructors otherwise.
# Glance renders widgets through a WorkManager session worker, so without this the widget never leaves its spinner.
-keep class * extends androidx.work.InputMerger { <init>(); }
-keep class androidx.work.OverwritingInputMerger { *; }
-keep class * extends androidx.work.ListenableWorker { <init>(...); }

# Glance instantiates ActionCallback classes reflectively when a widget is tapped.
-keep class * implements androidx.glance.appwidget.action.ActionCallback { <init>(); }
